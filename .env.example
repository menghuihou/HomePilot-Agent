# ---------- App ----------
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# ---------- PostgreSQL ----------
# 应用运行时使用异步驱动；Alembic 使用同步驱动。
POSTGRES_HOST_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=homepilot
POSTGRES_USER=homepilot
POSTGRES_PASSWORD=change-me
LANGFUSE_DB_NAME=langfuse
DATABASE_URL=postgresql+asyncpg://homepilot:change-me@localhost:5432/homepilot
DATABASE_URL_SYNC=postgresql+psycopg://homepilot:change-me@localhost:5432/homepilot

# ---------- Langfuse self-hosting ----------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
SALT=
# 必须是 64 位十六进制字符串，例如 openssl rand -hex 32 生成。
ENCRYPTION_KEY=
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=
MINIO_BUCKET=langfuse
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
REDIS_AUTH=

# 首次启动时初始化本地组织、项目、用户和 API key。
LANGFUSE_INIT_ORG_ID=homepilot
LANGFUSE_INIT_ORG_NAME=HomePilot
LANGFUSE_INIT_PROJECT_ID=homepilot-local
LANGFUSE_INIT_PROJECT_NAME=HomePilot Local
LANGFUSE_INIT_USER_EMAIL=local@example.com
LANGFUSE_INIT_USER_NAME=HomePilot Local
LANGFUSE_INIT_USER_PASSWORD=
# 本地可预置 API key，格式形如 lf_pk_... / lf_sk_...。
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=

# ---------- Langfuse ----------
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- OpenTelemetry ----------
OTEL_SERVICE_NAME=homepilot-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---------- Model Gateway ----------
MODEL_PROVIDER=cloud
MODEL_BASE_URL=
MODEL_API_KEY=
LIGHT_MODEL=

# ---------- Streamlit ----------
STREAMLIT_API_BASE_URL=http://127.0.0.1:8000
