# ---------- App ----------
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# ---------- PostgreSQL ----------
# 应用运行时使用异步驱动；Alembic 使用同步驱动。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=homepilot
POSTGRES_USER=homepilot
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://homepilot:change-me@localhost:5432/homepilot
DATABASE_URL_SYNC=postgresql+psycopg://homepilot:change-me@localhost:5432/homepilot

# ---------- Langfuse ----------
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- OpenTelemetry ----------
OTEL_SERVICE_NAME=homepilot-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---------- Model Gateway ----------
MODEL_PROVIDER=cloud
MODEL_BASE_URL=
MODEL_API_KEY=
LIGHT_MODEL=

# ---------- Streamlit ----------
STREAMLIT_API_BASE_URL=http://127.0.0.1:8000
